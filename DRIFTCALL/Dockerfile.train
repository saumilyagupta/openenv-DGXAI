# syntax=docker/dockerfile:1.6
# DriftCall — full training image for Akash Network GPU rentals.
#
# Builds on saumilyajj/dl-sam:2025 (CUDA + PyTorch + Unsloth pre-baked) and
# adds the DriftCall code, deps, and a one-shot training entrypoint that runs
# Stage 1 → Stage 2 → Stage 3 → baseline eval → final eval → reward-hacking
# probe → push trained LoRA + eval reports back to HF Hub.
#
# Usage on Akash:
#   docker build -f Dockerfile.train -t driftcall-train:latest .
#   docker run --gpus all \
#     -e WANDB_API_KEY=<key>           \
#     -e HF_TOKEN=<hf-write-token>     \
#     -e DRIFTCALL_HF_REPO=<user>/gemma-4-e2b-driftcall-lora \
#     -e DRIFTCALL_HARDWARE=h100       \
#     -v /tmp/checkpoints:/app/checkpoints \
#     driftcall-train:latest
#
# The entrypoint script writes checkpoints to /app/checkpoints — mount it as
# a host volume to keep adapters after the container exits. Logs stream to
# WandB if WANDB_API_KEY is set; otherwise fall back to cells/_secrets.py.

FROM saumilyajj/dl-sam:2025

LABEL org.opencontainers.image.title="DriftCall Trainer"
LABEL org.opencontainers.image.source="https://github.com/krrishchoudhary109/openenv-DGXAI"
LABEL org.opencontainers.image.licenses="Apache-2.0"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/root/.cache/huggingface \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    WANDB_PROJECT=driftcall \
    WANDB_MODE=online \
    DRIFTCALL_HARDWARE=h100 \
    DRIFTCALL_NUM_STEPS_STAGE1=150 \
    DRIFTCALL_NUM_STEPS_STAGE2=200 \
    DRIFTCALL_NUM_STEPS_STAGE3=150 \
    DRIFTCALL_EVAL_EPISODES=50 \
    DRIFTCALL_PROBE_EPISODES=200 \
    DRIFTCALL_OUTPUT_DIR=/app/checkpoints \
    DRIFTCALL_HF_REPO="" \
    DRIFTCALL_PUSH_TO_HUB=true

# Create the writable mount point upfront so volume mounts inherit perms.
RUN mkdir -p /app/checkpoints /app/logs /app/eval_reports

WORKDIR /app

# Install system tools commonly missing from minimal CUDA bases.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        build-essential \
        libsndfile1 \
        ffmpeg \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps. requirements.txt covers the core training stack
# (unsloth, trl, torch, transformers, peft, bitsandbytes, accelerate,
# wandb, kokoro, faster-whisper, etc.). hf_transfer accelerates pulls
# from the HF Hub on Akash's bandwidth.
COPY requirements.txt ./
RUN pip install --upgrade pip \
    && pip install -r requirements.txt \
    && pip install hf_transfer

# Application code — full repo so the entrypoint can call any cell.
COPY cells/ ./cells/
COPY tests/ ./tests/
COPY app.py openenv.yaml pyproject.toml ./
COPY data/ ./data/
COPY scripts/ ./scripts/
COPY notebooks/ ./notebooks/
COPY server/ ./server/
COPY README.md ./
COPY DESIGN.md ./
COPY CLAUDE.md ./
COPY docs/ ./docs/

# Pre-pull base model weights at build time so the container can run
# offline if needed. Wrap in a try/except — Akash builders may not have
# HF auth at build time; in that case the entrypoint pulls at run time
# (HF_TOKEN must then be set on the docker run command).
ARG HF_TOKEN_BUILD=""
RUN if [ -n "$HF_TOKEN_BUILD" ]; then \
        HF_TOKEN="$HF_TOKEN_BUILD" python3 -c "from huggingface_hub import snapshot_download; \
        snapshot_download('unsloth/gemma-4-E2B-it-bnb-4bit')" || true ; \
    fi

# Quick smoke check at build time — verify imports work.
RUN python3 -c "import torch, trl, peft, wandb, transformers; \
                print(f'torch {torch.__version__}, trl {trl.__version__}, wandb {wandb.__version__}')"

# Training entrypoint — runs the full 3-stage pipeline + eval + probe + push.
COPY scripts/train_full.sh /usr/local/bin/train_full.sh
RUN chmod +x /usr/local/bin/train_full.sh

# tini handles SIGTERM cleanly so Akash can preempt without corrupting
# checkpoints mid-write.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/train_full.sh"]

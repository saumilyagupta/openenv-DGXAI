# syntax=docker/dockerfile:1.6
# DriftCall — full training image for Akash Network GPU rentals.
#
# Self-contained: clones the repo at build time (or run time), installs
# dependencies, then runs Stage 1 → Stage 2 → Stage 3 → baseline eval →
# final eval → reward-hacking probe → plots → summary → push to HF Hub.
#
# Built on saumilyajj/dl-sam:2025. The base provides:
#   - Ubuntu + CUDA 12.3 (CUDA_VERSION=12.3.0, NV_CUDA_CUDART_VERSION=12.3.52-1)
#   - Python 3.11
#   - TensorFlow 2.19.0 (the only ML framework pre-installed — we don't use it)
#   - git-all, openssh-server, tmux pre-installed
#   - Default CMD: `sshd -D` on port 22 (we override to run training instead)
# We install PyTorch + Unsloth + TRL + everything from requirements.txt fresh.
#
# Usage:
#   # Public repo:
#   docker build -f Dockerfile.train -t driftcall-train:v1 .
#
#   # Private repo (passes a fine-grained PAT to the build):
#   docker build -f Dockerfile.train \
#     --build-arg GITHUB_TOKEN=$GITHUB_TOKEN \
#     -t driftcall-train:v1 .
#
#   docker run --gpus all \
#     -e HF_TOKEN=<hf-write-token> \
#     -e DRIFTCALL_HF_REPO=<user>/gemma-4-e2b-driftcall-lora \
#     -v /tmp/akash-data:/mnt/data \
#     driftcall-train:v1
#
# On Akash, the SDL mounts a persistent volume at /mnt/data; checkpoints
# survive pod restarts. Logs stream to WandB if WANDB_API_KEY is set;
# otherwise the hardcoded fallback in cells/_secrets.py is used.

FROM saumilyajj/dl-sam:2025

LABEL org.opencontainers.image.title="DriftCall Trainer"
LABEL org.opencontainers.image.source="https://github.com/krrishchoudhary109/openenv-DGXAI"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# ---------------------------------------------------------------------------
# Base environment
# ---------------------------------------------------------------------------
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/mnt/data/hf_cache \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    WANDB_PROJECT=driftcall \
    WANDB_MODE=online \
    DRIFTCALL_HARDWARE=h100 \
    DRIFTCALL_NUM_STEPS_STAGE1=150 \
    DRIFTCALL_NUM_STEPS_STAGE2=200 \
    DRIFTCALL_NUM_STEPS_STAGE3=150 \
    DRIFTCALL_EVAL_EPISODES=50 \
    DRIFTCALL_PROBE_EPISODES=200 \
    DRIFTCALL_OUTPUT_DIR=/mnt/data/checkpoints \
    DRIFTCALL_HF_REPO="" \
    DRIFTCALL_PUSH_TO_HUB=true

# ---------------------------------------------------------------------------
# System tools — base already has git, openssh-server, tmux, curl. Only
# need libsndfile1 (Kokoro TTS), ffmpeg (whisper ASR), tini (SIGTERM
# handling), build-essential (some Python wheels need a C compiler).
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libsndfile1 \
        ffmpeg \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Start sshd in the background so the SDL's port-22 expose works for
# tmux attach during long training runs (matches Akash dev-pod UX).
# Detach the daemon — never block the trainer's main process.
RUN mkdir -p /var/run/sshd && \
    echo 'PermitRootLogin yes' > /etc/ssh/sshd_config.d/99-akash.conf && \
    echo 'UsePAM yes' >> /etc/ssh/sshd_config.d/99-akash.conf

# ---------------------------------------------------------------------------
# Persistent + ephemeral mount points (SDL maps /mnt/data persistent)
# ---------------------------------------------------------------------------
RUN mkdir -p /mnt/data/checkpoints /mnt/data/hf_cache \
             /app/logs /app/eval_reports

WORKDIR /app

# ---------------------------------------------------------------------------
# Clone the repo at build time
#
# Build args:
#   GIT_REPO_URL — full HTTPS URL of the repo (default: public)
#   GIT_REF      — branch / tag / commit SHA (default: main)
#   GITHUB_TOKEN — fine-grained PAT for private repo access (optional)
#   SUBPATH      — path inside the repo containing the DriftCall package
# ---------------------------------------------------------------------------
ARG GIT_REPO_URL=https://github.com/krrishchoudhary109/openenv-DGXAI.git
ARG GIT_REF=main
ARG GITHUB_TOKEN=""
ARG SUBPATH=DRIFTCALL

RUN if [ -n "$GITHUB_TOKEN" ]; then \
        AUTHED_URL=$(echo "$GIT_REPO_URL" | sed "s|https://|https://${GITHUB_TOKEN}@|") ; \
    else \
        AUTHED_URL="$GIT_REPO_URL" ; \
    fi && \
    git clone --depth 1 --branch "$GIT_REF" "$AUTHED_URL" /tmp/repo && \
    cp -r /tmp/repo/${SUBPATH}/. /app/ && \
    rm -rf /tmp/repo

# ---------------------------------------------------------------------------
# Python deps
#
# Base image only has TensorFlow 2.19. We install PyTorch + Unsloth + TRL
# + everything else from requirements.txt fresh. CUDA 12.3 is already
# installed — torch will pick the matching cu121/cu124 wheel automatically.
#
# This is a heavy step (~5 GB download). Layer is cached aggressively
# because requirements.txt rarely changes.
# ---------------------------------------------------------------------------
RUN pip install --upgrade pip wheel setuptools
RUN pip install -r requirements.txt
RUN pip install hf_transfer
# Install the project as a package so `from cells.* import` works from any
# CWD without relying on PYTHONPATH side effects.
RUN pip install --no-deps -e .

RUN python3 -c "import torch, trl, peft, wandb, transformers; \
                print(f'torch={torch.__version__} trl={trl.__version__} ' \
                      f'wandb={wandb.__version__} transformers={transformers.__version__}')"

# ---------------------------------------------------------------------------
# Pre-pull base model weights at build time (optional — guarded by build arg)
# ---------------------------------------------------------------------------
ARG HF_TOKEN_BUILD=""
RUN if [ -n "$HF_TOKEN_BUILD" ]; then \
        HF_TOKEN="$HF_TOKEN_BUILD" python3 -c \
            "from huggingface_hub import snapshot_download; \
             snapshot_download('unsloth/gemma-4-E2B-it-bnb-4bit')" || true ; \
    fi

# ---------------------------------------------------------------------------
# Entrypoint wrapper — start sshd in background, then run training pipeline.
#
# Akash exposes port 22 via the SDL so you can `ssh root@<pod>` during
# training, attach to the tmux session running train_full.sh, and watch
# progress live. Default root password is "root" (set by the base image).
# Change it via -e ROOT_PASSWORD=<new> at run time if exposed publicly.
# ---------------------------------------------------------------------------
RUN cp /app/scripts/train_full.sh /usr/local/bin/train_full.sh && \
    chmod +x /usr/local/bin/train_full.sh

RUN cat > /usr/local/bin/akash_entrypoint.sh <<'EOF' && chmod +x /usr/local/bin/akash_entrypoint.sh
#!/usr/bin/env bash
set -e
# Optional override of root password before sshd starts.
if [ -n "${ROOT_PASSWORD:-}" ]; then
    echo "root:${ROOT_PASSWORD}" | chpasswd
fi
# Start sshd in background — port 22 stays accessible for tmux attach.
/usr/sbin/sshd
# Run the training pipeline inside a named tmux session so the user can
# `tmux attach -t train` after ssh-ing in.
exec tmux new-session -d -s train "/usr/local/bin/train_full.sh 2>&1 | tee -a /app/logs/train.log"
# Hold the container open while tmux runs the training in detached mode.
# Container exits when train_full.sh finishes (success or failure).
while tmux has-session -t train 2>/dev/null; do sleep 30; done
echo "[entrypoint] tmux session ended; container will exit"
# Cat the final log line for visibility in `docker logs`.
tail -50 /app/logs/train.log || true
EOF

# tini handles SIGTERM cleanly so Akash spot preemption doesn't corrupt
# checkpoints mid-write.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/akash_entrypoint.sh"]

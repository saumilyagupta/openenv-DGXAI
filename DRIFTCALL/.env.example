# DriftCall — example .env file. Copy to .env (gitignored) and fill in real values.
#
# Loaded by docker run via --env-file or by direct shell sourcing:
#   docker run --env-file .env --gpus all -v /tmp/akash-data:/mnt/data <image>
#   set -a && source .env && set +a
#
# Override priority for tokens (highest → lowest):
#   1. Shell env (export FOO=bar before running)
#   2. .env (this file, when sourced)
#   3. cells/_secrets.py hardcoded fallback (private-repo only — applies to wandb)
#   4. None — runtime errors when WANDB_MODE != "disabled" / HF_TOKEN missing on push

# ---------------------------------------------------------------------------
# Tokens — REQUIRED for full training run
# ---------------------------------------------------------------------------

# Hugging Face Hub write token. Required to push trained LoRA + eval reports.
# Generate at https://huggingface.co/settings/tokens (with "write" scope).
HF_TOKEN=hf_REPLACE_ME_WITH_YOUR_HF_WRITE_TOKEN

# Hugging Face Hub read token (optional — used at Docker BUILD time to pre-pull
# Gemma 4 E2B 4-bit weights so the first run starts ~3 min faster). Can be the
# same as HF_TOKEN if your write token also has read scope.
HF_TOKEN_BUILD=hf_REPLACE_ME_OR_REUSE_HF_TOKEN

# DriftCall env-server bearer token. Random ≥ 32 bytes recommended.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DRIFTCALL_ENV_TOKEN=REPLACE_ME_WITH_64_RANDOM_BYTES

# WandB API key. OPTIONAL — cells/_secrets.py has a hardcoded fallback for
# private-repo runs. Set this only to override the hardcoded value at runtime
# without rebuilding the image.
# Get at https://wandb.ai/authorize
WANDB_API_KEY=

# GitHub Personal Access Token — only needed when Docker build clones a
# PRIVATE repo. Use a fine-grained PAT with read:repo scope.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# WandB run configuration
# ---------------------------------------------------------------------------

WANDB_PROJECT=driftcall
WANDB_ENTITY=                                  # leave blank for personal account
WANDB_MODE=online                              # online | offline | disabled

# ---------------------------------------------------------------------------
# DriftCall training knobs
# ---------------------------------------------------------------------------

# HF Hub repo to push trained LoRA + eval reports.
DRIFTCALL_HF_REPO=krrishchoudhary109/gemma-4-e2b-driftcall-lora

# Hardware profile — picks BF16+FA3+fused-AdamW (h100) or FP16+8-bit-paged (v100).
DRIFTCALL_HARDWARE=h100

# Per-stage GRPO step counts. Defaults match training.md §3.5.
DRIFTCALL_NUM_STEPS_STAGE1=150
DRIFTCALL_NUM_STEPS_STAGE2=200
DRIFTCALL_NUM_STEPS_STAGE3=150

# Eval + probe episode counts.
DRIFTCALL_EVAL_EPISODES=50
DRIFTCALL_PROBE_EPISODES=200

# Output directories — match the SDL persistent volume mount at /mnt/data.
DRIFTCALL_OUTPUT_DIR=/mnt/data/checkpoints
DRIFTCALL_EVAL_DIR=/mnt/data/eval_reports
DRIFTCALL_LOG_DIR=/app/logs
DRIFTCALL_BRIEFS_PATH=/app/data/val/briefs.jsonl

# Whether to push trained LoRA to HF Hub at the end of training.
DRIFTCALL_PUSH_TO_HUB=true

# Pluggable rollout / eval implementations (dotted module:attr paths).
# Required by run_pipeline.py for the heavy rollout + eval delegates that
# the orchestrator deliberately keeps outside the cell modules.
DRIFTCALL_ROLLOUT_IMPL=
DRIFTCALL_TRAINING_EVAL_IMPL=

# ---------------------------------------------------------------------------
# Caching / performance
# ---------------------------------------------------------------------------

HF_HOME=/mnt/data/hf_cache
HF_HUB_ENABLE_HF_TRANSFER=1
TRANSFORMERS_VERBOSITY=info
PYTHONUNBUFFERED=1

# Reproducibility — keep set to 0 for byte-identical reruns.
PYTHONHASHSEED=0

# ---------------------------------------------------------------------------
# OpenEnv server (only used if you expose port 7860 on the pod)
# ---------------------------------------------------------------------------

HOST=0.0.0.0
PORT=7860

# ---------------------------------------------------------------------------
# SSH (the base image runs sshd on :22; default root password is "root")
# ---------------------------------------------------------------------------

# Override the default root password before sshd starts.
ROOT_PASSWORD=

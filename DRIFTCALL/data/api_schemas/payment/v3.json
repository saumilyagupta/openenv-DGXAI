{
  "$comment": "SPDX-License-Identifier: Apache-2.0. Copyright 2026 DriftCall Team. Payment v3 after mfa_required policy flip per DESIGN.md §5.5 and docs/modules/drift_injector.md §4.4. Adds mandatory mfa_code field for any charge subject to MFA enforcement; otherwise identical to v2.",
  "$id": "https://driftcall.dev/schemas/payment/v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amount_inr": {
      "minimum": 0,
      "type": "integer"
    },
    "charge_id": {
      "minLength": 1,
      "type": "string"
    },
    "mfa_code": {
      "minLength": 1,
      "type": "string"
    },
    "payment_token": {
      "minLength": 1,
      "type": "string"
    },
    "scope": {
      "const": "payments:write:v2",
      "type": "string"
    },
    "status": {
      "enum": ["ok", "auth_error"],
      "type": "string"
    }
  },
  "required": ["charge_id", "amount_inr", "payment_token", "scope", "status", "mfa_code"],
  "title": "Payment charge (v3)",
  "type": "object"
}

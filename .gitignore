# Root ignores for the DriftCall-only repo.
# Product-level ignores live in DRIFTCALL/.gitignore.

# OS / editor
.DS_Store
.idea/
.vscode/

# Python / tooling at repo root
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Secrets (never commit at root)
.env
.env.*
.driftcall.env
!.env.example
